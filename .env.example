# LLM — required from Step 4 onward
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# Web search — required from Step 6 onward
TAVILY_API_KEY=

# Observability — optional from Step 10 onward (https://smith.langchain.com)
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=us-stock-research

# SEC EDGAR — required from Step 1 onward (your name + email per SEC fair access policy)
SEC_EDGAR_USER_AGENT="YourName your.email@example.com"

# Embeddings / Chroma — optional overrides for Step 3+
EMBEDDING_MODEL=all-MiniLM-L6-v2
CHROMA_COLLECTION=sec_10k_filings
